# The frontend talks ONLY to the Gateway — never directly to a microservice.
VITE_API_BASE_URL=http://localhost:8000

# Set to "false" once real Gateway contracts have been confirmed and wired
# into src/services/apiClient.js. See src/services/config.js.
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_CONVERSATIONS=true
VITE_USE_MOCK_KNOWLEDGE=true
VITE_USE_MOCK_AUDIO=true
